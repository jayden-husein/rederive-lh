{
  "name": "rederive-lh",
  "version": "0.3.0",
  "private": true,
  "description": "LearnHarness plugin that teaches a codebase by having the learner re-derive its design decisions.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "sdk": "node scripts/sdk.ts",
    "build": "node scripts/build.ts",
    "package": "node scripts/package.ts --check && npm run build && node scripts/package.ts",
    "typecheck": "tsc --noEmit",
    "summary": "node scripts/summary.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "measure": "node scripts/measure.ts",
    "routing-report": "node scripts/routing-report.ts",
    "transcript": "node scripts/transcript.ts",
    "leak-check": "node scripts/leak-check.ts",
    "render-diagrams": "node scripts/render-diagrams.ts",
    "check": "npm run typecheck && npm test",
    "prepare": "git config core.hooksPath .githooks || echo Not a git checkout: the commit hook was not installed"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "^22.18.0",
    "esbuild": "^0.28.2",
    "learnharness-plugin-api": "file:./.sdk",
    "typebox": "^1.3.27",
    "typescript": "^5.9.3"
  }
}
